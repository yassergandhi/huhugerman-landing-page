---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Preparación personalizada para hispanohablantes que van a Alemania. Reduce vulnerabilidad lingüística, institucional y social antes del viaje.",
  canonical,
  ogTitle,
  noindex = false,
} = Astro.props;

const resolvedOgTitle = ogTitle || title;
const resolvedCanonical = canonical || "https://huhugerman.com/";
---
<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="preparación para Alemania, alemán real, alemán coloquial, cultura alemana, amigos alemanes, Sperrkonto, visa estudiante Alemania, Ausländerbehörde, riesgo financiero estudiar en Alemania, English bubble, alemán burocrático, Hochdeutsch, Umgangssprache, huhuGERMAN">
  <meta name="author" content="Yasser Gandhi Hernández Esquivel">
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  }
  <meta name="theme-color" content="#040608">

  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="alternate" hreflang="es-MX" href={resolvedCanonical}>
  <link rel="alternate" hreflang="es-ES" href={resolvedCanonical}>
  <link rel="alternate" hreflang="es-AR" href={resolvedCanonical}>
  <link rel="alternate" hreflang="es-CO" href={resolvedCanonical}>
  <link rel="alternate" hreflang="x-default" href={resolvedCanonical}>

  <!-- Academic identifiers — EEAT -->
  <link rel="me" href="https://orcid.org/0000-0002-8736-184X" />
  <meta name="citation_author" content="Hernández Esquivel, Yasser Gandhi" />
  <meta name="citation_author_institution" content="CELEX, UAM Azcapotzalco" />

  <meta property="og:type" content="website">
  <meta property="og:url" content={resolvedCanonical}>
  <meta property="og:title" content={resolvedOgTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://huhugerman.com/og/huhugerman-riesgo-2026.jpg">
  <meta property="og:locale" content="es_MX">
  <meta property="og:site_name" content="huhuGERMAN">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={resolvedOgTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://huhugerman.com/og/huhugerman-riesgo-2026.jpg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@400;500&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">

  <link rel="dns-prefetch" href="https://valletta.diplo.de">
  <link rel="dns-prefetch" href="https://www.tk.de">
  <link rel="dns-prefetch" href="https://www.make-it-in-germany.com">
  <link rel="dns-prefetch" href="https://aktuelles.uni-frankfurt.de">
  <link rel="dns-prefetch" href="https://www.uni-leipzig.de">
  <link rel="dns-prefetch" href="https://www.studierendenwerke.de">
  <link rel="dns-prefetch" href="https://stadt.muenchen.de">
  <link rel="dns-prefetch" href="https://www.gesetze-im-internet.de">
  <link rel="dns-prefetch" href="https://www.verbraucherzentrale.de">
  <link rel="dns-prefetch" href="https://www.revista.unam.mx">
  <link rel="dns-prefetch" href="https://tesiunam.dgb.unam.mx">
  <link rel="dns-prefetch" href="https://yassergandhi.dev">

  <slot name="head" />

  <style>
    :root {
      --bg:        #040608;
      --bg-2:      #090d12;
      --bg-3:      #0d1218;
      --surface:   #111820;
      --surface-2: #141d28;
      --line:      #1e2a38;
      --text:      #f0eae0;
      --text-soft: #9aabba;
      --text-mid:  #c5d0dc;
      --acid:      #d4e847;
      --acid-2:    #eeff72;
      --danger:    #ff6b55;
      --yellow:    #f0c400;
      --shadow:    0 20px 60px rgba(0,0,0,.45);
      --radius:    22px;
      --radius-sm: 14px;
      --container: 1240px;
      --navh:      68px;
      --font-display:   "Bebas Neue", sans-serif;
      --font-narrative: "Ubuntu", serif;
      --font-body:      "Ubuntu", sans-serif;
      --font-mono:      "DM Mono", monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-body);
      background:
        radial-gradient(ellipse at top, rgba(212,232,71,.07) 0%, transparent 40%),
        radial-gradient(ellipse at 80% 0%, rgba(255,107,85,.09) 0%, transparent 35%),
        linear-gradient(180deg, #080c11 0%, var(--bg) 30%, #060810 100%);
      color: var(--text);
      line-height: 1.65;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; }
    a { color: var(--acid); text-decoration: none; }
    a:hover { color: var(--acid-2); }
    a:visited { color: var(--acid); }

    .skip-link {
      position: absolute; left: 12px; top: -48px;
      background: var(--acid); color: #080b0f;
      padding: .75rem 1rem; border-radius: 10px;
      z-index: 10001; font-weight: 700;
    }
    .skip-link:focus { top: 12px; }

    .container {
      width: min(var(--container), calc(100% - 2rem));
      margin: 0 auto;
    }

    /* ── LOADER ── */
    .loader {
      position: fixed; inset: 0; z-index: 9999;
      display: grid; place-items: center;
      background: radial-gradient(circle at center, #0e1520 0%, #040608 65%);
      transition: opacity .55s ease, visibility .55s ease;
    }
    .loader.hidden { opacity: 0; visibility: hidden; }
    .loader-box { text-align: center; }
    .loader-words{
      font-family:var(--display);
      font-size:clamp(3rem, 10vw, 6rem);
      line-height:.9; letter-spacing:.08em;
    }
    .loader-words span{display:block}
    .loader-words span:nth-child(1){color:var(--danger)}
    .loader-words span:nth-child(2){color:var(--warn)}
    .loader-words span:nth-child(3){color:var(--acid)}
    .loader-sub {
      font-family: var(--font-mono);
      text-transform: uppercase; letter-spacing: .16em;
      font-size: .76rem; color: var(--acid);
      margin-top: 1.1rem;
    }
    .loader-track {
      width: min(300px, 72vw); height: 2px;
      background: rgba(255,255,255,.1);
      overflow: hidden; border-radius: 999px;
      margin: 1rem auto 0;
    }
    .loader-track::after {
      content: ""; display: block; width: 45%; height: 100%;
      background: linear-gradient(90deg, transparent, var(--acid), transparent);
      animation: bar 1.1s linear infinite;
    }
    @keyframes bar { from{transform:translateX(-130%)} to{transform:translateX(280%)} }

    /* ── NAV ── */
    .site-nav {
      position: sticky; top: 0; z-index: 1000;
      backdrop-filter: blur(20px) saturate(1.4);
      background: rgba(4,6,8,.75);
      border-bottom: 1px solid rgba(255,255,255,.05);
      min-height: var(--navh);
    }
    .nav-inner {
      width: min(var(--container), calc(100% - 2rem));
      margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      min-height: var(--navh);
    }
    .brand {
      display: inline-flex; align-items: center;
      font-family: var(--font-display); font-size: 1.65rem; letter-spacing: .06em;
      color: var(--text); white-space: nowrap;
    }
    .brand .german { color: var(--acid); }
    .nav-links {
      display: flex; align-items: center; gap: .3rem;
      list-style: none; flex-wrap: wrap;
    }
    .nav-links a {
      color: var(--text-soft); font-size: .875rem; font-weight: 600;
      padding: .5rem .7rem; border-radius: 8px;
      border: 1px solid transparent;
      transition: color .15s, border-color .15s, background .15s;
    }
    .nav-links a:hover {
      color: var(--text); border-color: rgba(212,232,71,.2);
      background: rgba(212,232,71,.06);
    }
    .nav-cta {
      display: inline-flex; align-items: center;
      padding: .65rem 1rem; border-radius: 999px;
      background: var(--acid); color: #090b0e;
      font-weight: 700; font-size: .875rem; white-space: nowrap;
    }
    .nav-cta:hover { background: var(--acid-2); color: #090b0e; }
    .nav-toggle {
      display: none; flex-direction: column; justify-content: center; gap: 5px;
      background: none; border: none; cursor: pointer; padding: 6px;
    }
    .nav-toggle span {
      display: block; width: 22px; height: 2px;
      background: var(--text-soft); border-radius: 2px;
      transition: transform .2s, opacity .2s;
    }
    .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: rotate(45deg) translate(4px,5px); }
    .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: rotate(-45deg) translate(4px,-5px); }

    /* ── GLOBAL LAYOUT ── */
    main { display: block; }
    .section { padding: clamp(4rem, 7vw, 6rem) 0; scroll-margin-top: calc(var(--navh) + 16px); }
    .section.alt { background: linear-gradient(180deg, rgba(255,255,255,.018), rgba(255,255,255,0)); }

    .section-label {
      font-family: var(--font-mono); font-size: .74rem;
      text-transform: uppercase; letter-spacing: .14em;
      color: var(--acid); margin-bottom: .5rem;
      display: flex; align-items: center; gap: .55rem;
    }
    .section-label::before { content: "·"; font-size: 1rem; }
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 6vw, 4rem);
      line-height: .92; letter-spacing: .02em;
      text-transform: uppercase; margin-bottom: .85rem;
    }
    .section-title .danger { color: var(--danger); }
    .section-intro {
      max-width: 680px; font-size: 1.05rem;
      color: var(--text-soft); margin-bottom: 1.8rem;
    }

    .eyebrow {
      display: inline-flex; align-items: center; gap: .5rem;
      padding: .35rem .75rem; border-radius: 999px;
      border: 1px solid rgba(212,232,71,.2);
      background: rgba(212,232,71,.05);
      color: var(--acid); font-family: var(--font-mono);
      font-size: .74rem; text-transform: uppercase; letter-spacing: .1em;
      margin-bottom: 1rem;
    }
    .eyebrow::before {
      content: ""; width: 7px; height: 7px; border-radius: 50%;
      background: currentColor; box-shadow: 0 0 0 5px rgba(212,232,71,.1);
    }

    /* ── BUTTONS ── */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
      min-height: 44px; padding: .8rem 1.1rem; border-radius: 999px; font-weight: 700;
      transition: transform .15s, background .15s, border-color .15s;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary { background: var(--acid); color: #090b0e; }
    .btn-primary:hover { background: var(--acid-2); color: #090b0e; }
    .btn-secondary {
      color: var(--text); border: 1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.04);
    }
    .btn-secondary:hover { border-color: rgba(212,232,71,.3); background: rgba(212,232,71,.08); }
    .cta-group {
      display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.1rem;
    }

    /* ── SOURCE CHIPS ── */
    .source-chip {
      display: inline-flex; align-items: center; gap: .35rem;
      padding: .35rem .65rem; border-radius: 999px;
      background: rgba(212,232,71,.07); border: 1px solid rgba(212,232,71,.18);
      color: var(--acid); font-family: var(--font-mono); font-size: .72rem;
      font-weight: 600; white-space: nowrap;
    }
    .source-chip:hover { background: rgba(212,232,71,.14); color: var(--acid-2); }
    .inline-source {
      display: inline-flex; align-items: center;
      font-family: var(--font-mono); font-size: .68rem; color: var(--acid);
      border-bottom: 1px dashed rgba(212,232,71,.4);
    }
    .inline-source:hover { color: var(--acid-2); }

    /* ── WARNING BOX ── */
    .warning-box {
      padding: .95rem 1.1rem; border-radius: var(--radius-sm);
      background: rgba(255,107,85,.07); border: 1px solid rgba(255,107,85,.2);
      color: var(--text-mid); font-size: .94rem; line-height: 1.55;
    }
    .warning-box strong { color: var(--danger); }

    /* ── HERO ── */
    .hero { padding: clamp(2rem, 4vw, 3.5rem) 0 0; }
    .hero-grid {
      display: grid; grid-template-columns: 1.15fr .85fr;
      gap: 1.25rem; align-items: start;
    }
    .hero-main, .hero-aside {
      background: linear-gradient(180deg, rgba(17,24,32,.9), rgba(10,15,22,.97));
      border: 1px solid rgba(255,255,255,.06);
      border-radius: 28px; padding: clamp(1.4rem, 3vw, 2.2rem);
      box-shadow: var(--shadow);
    }
    h1 {
      font-family: var(--font-display);
      font-size: clamp(3.2rem, 10vw, 6.5rem);
      line-height: .88; letter-spacing: .02em;
      text-transform: uppercase; margin: .2rem 0 1rem;
    }
    h1 .accent { color: var(--acid); display: block; }
    .lead {
      font-size: clamp(.98rem, 1.4vw, 1.1rem); color: var(--text-soft);
      max-width: 62ch; line-height: 1.7; margin-bottom: .75rem;
    }
    .hero-copy-strong { color: var(--text); font-weight: 600; }
    .nav-note {
      font-family: var(--font-mono); font-size: .74rem;
      text-transform: uppercase; letter-spacing: .1em; color: var(--text-soft);
      margin-top: .85rem;
    }

    /* aside */
    .aside-stamp {
      font-family: var(--font-mono); font-size: .72rem;
      text-transform: uppercase; letter-spacing: .12em; color: var(--acid);
      margin-bottom: .75rem;
    }
    .aside-title {
      font-family: var(--font-display); font-size: 1.7rem;
      letter-spacing: .03em; text-transform: uppercase;
      color: var(--text); margin-bottom: .85rem;
    }
    .aside-narrative {
      font-family: var(--font-narrative); font-style: italic;
      font-size: 1.04rem; color: var(--text-soft); line-height: 1.7;
      margin-bottom: .75rem;
    }
    .aside-narrative:last-of-type { margin-bottom: 0; }
    .aside-narrative strong { color: var(--text); font-style: normal; font-weight: 600; }
    .aside-pull {
      font-family: var(--font-narrative); font-style: italic;
      font-size: 1.05rem; color: var(--text-mid);
      border-left: 2px solid var(--acid);
      padding-left: 1rem; margin: 1rem 0;
      line-height: 1.65;
    }
    .aside-risk-list {
      list-style: none; display: grid; gap: .6rem; margin-top: 1rem;
    }
    .aside-risk-list li {
      padding: .7rem .85rem; border-radius: var(--radius-sm);
      background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.06);
    }
    .aside-risk-list strong { display: block; font-size: .95rem; margin-bottom: .2rem; }
    .aside-risk-list span { color: var(--text-soft); font-size: .88rem; }

    /* evidence band */
    .evidence-band {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: .85rem;
      margin-top: 1.4rem;
    }
    .evidence-card {
      background: linear-gradient(180deg, rgba(17,24,32,.92), rgba(10,15,22,.97));
      border: 1px solid rgba(255,255,255,.06);
      border-radius: var(--radius); padding: 1rem 1.1rem;
      box-shadow: var(--shadow);
    }
    .evidence-card .num {
      font-family: var(--font-display); font-size: 2.2rem;
      letter-spacing: .02em; color: var(--acid);
      line-height: .95; margin-bottom: .55rem;
    }
    .evidence-card p { color: var(--text-soft); font-size: .88rem; line-height: 1.55; margin-bottom: .75rem; }
    .evidence-card .source-chip { margin-top: auto; }

    /* ── BRECHA ── */
    .split-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem;
    }
    .split-card {
      padding: 1.2rem; border-radius: var(--radius);
      border: 1px solid rgba(255,255,255,.06);
    }
    .split-card.school {
      background: rgba(255,255,255,.03);
    }
    .split-card.reality {
      background: rgba(255,107,85,.05);
      border-color: rgba(255,107,85,.15);
    }
    .split-card h3 {
      font-family: var(--font-display); font-size: 1.55rem;
      letter-spacing: .03em; margin-bottom: .85rem;
    }
    .split-card.reality h3 { color: var(--danger); }
    .split-card ul { list-style: none; display: grid; gap: .6rem; }
    .split-card li {
      padding-left: 1.1rem; position: relative;
      color: var(--text-soft); font-size: .95rem;
    }
    .split-card li::before {
      content: "–"; position: absolute; left: 0;
      color: rgba(255,255,255,.3);
    }
    .split-card.reality li::before { color: rgba(255,107,85,.5); }

    /* ── ESCENAS STACK ── */
    .stack-section-note {
      font-family: var(--font-mono); font-size: .76rem;
      text-transform: uppercase; letter-spacing: .1em;
      color: var(--text-soft); margin-bottom: 1.1rem;
    }
    .stack-help {
      font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em;
      text-transform: uppercase; color: var(--acid); text-align: center;
      margin-bottom: .5rem;
    }
    .stack-wrap {
      position: relative; width: min(520px, 100%); height: 640px;
      margin: 0 auto; perspective: 1200px;
    }
    .stack-card {
      position: absolute; inset: 0;
      background: #f2ebe0; color: #12181f;
      border-radius: 20px; padding: 1.1rem;
      box-shadow: 0 18px 50px rgba(0,0,0,.45);
      transition: transform .32s ease, opacity .32s ease;
      transform-origin: center bottom;
      cursor: pointer; user-select: none; outline: none;
    }
    .stack-card:focus-visible {
      box-shadow: 0 0 0 3px rgba(212,232,71,.5), 0 18px 50px rgba(0,0,0,.45);
    }
    .stack-card:nth-child(1)  { transform: rotate(-4deg)  translateZ(0);     z-index: 12; }
    .stack-card:nth-child(2)  { transform: rotate(-3deg)  translateZ(-11px);  z-index: 11; }
    .stack-card:nth-child(3)  { transform: rotate(-2deg)  translateZ(-22px);  z-index: 10; }
    .stack-card:nth-child(4)  { transform: rotate(-1deg)  translateZ(-33px);  z-index:  9; }
    .stack-card:nth-child(5)  { transform: rotate(0deg)   translateZ(-44px);  z-index:  8; }
    .stack-card:nth-child(6)  { transform: rotate(1deg)   translateZ(-55px);  z-index:  7; }
    .stack-card:nth-child(7)  { transform: rotate(2deg)   translateZ(-66px);  z-index:  6; }
    .stack-card:nth-child(8)  { transform: rotate(3deg)   translateZ(-77px);  z-index:  5; }
    .stack-card:nth-child(9)  { transform: rotate(4deg)   translateZ(-88px);  z-index:  4; }
    .stack-card:nth-child(10) { transform: rotate(5deg)   translateZ(-99px);  z-index:  3; }
    .stack-card:nth-child(11) {
      transform: rotate(6deg) translateZ(-110px); z-index: 2;
      background: linear-gradient(135deg, #ff6f58, #b63720); color: #fff4f0;
    }
    .stack-card:nth-child(12) {
      transform: rotate(7deg) translateZ(-121px); z-index: 1;
      background: linear-gradient(135deg, var(--acid), var(--acid-2)); color: #111;
    }
    .stack-card.discarded {
      transform: translateX(110vw) rotate(22deg) !important;
      opacity: 0; pointer-events: none;
    }
    .stack-card:hover:not(.discarded) {
      transform: rotate(0) scale(1.018) translateZ(0); z-index: 99;
    }
    .stack-art {
      height: 52%; border-radius: 16px;
      display: flex; align-items: flex-end; padding: .7rem;
      font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em;
      text-transform: uppercase; color: rgba(255,255,255,.85);
      background: linear-gradient(180deg, rgba(0,0,0,.1), rgba(0,0,0,.55)),
                  linear-gradient(135deg, #2b3c4e, #111923);
      margin-bottom: .7rem;
    }
    .stack-card:nth-child(2)  .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.55)), linear-gradient(135deg, #6e352c, #1a0f0d); }
    .stack-card:nth-child(3)  .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.5)),  linear-gradient(135deg, #6b7d34, #151f10); }
    .stack-card:nth-child(4)  .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.5)),  linear-gradient(135deg, #3c5c70, #0e1a22); }
    .stack-card:nth-child(5)  .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.5)),  linear-gradient(135deg, #4e3a6a, #130e1d); }
    .stack-card:nth-child(6)  .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.5)),  linear-gradient(135deg, #2e5640, #0e1a14); }
    .stack-card:nth-child(7)  .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.5)),  linear-gradient(135deg, #5a4030, #160e0a); }
    .stack-card:nth-child(8)  .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.5)),  linear-gradient(135deg, #4a6070, #101820); }
    .stack-card:nth-child(9)  .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.5)),  linear-gradient(135deg, #354860, #0e141c); }
    .stack-card:nth-child(10) .stack-art { background: linear-gradient(180deg, rgba(0,0,0,.1),rgba(0,0,0,.5)),  linear-gradient(135deg, #4a2a28, #140c0c); }
    .stack-card:nth-child(11) .stack-art { background: rgba(0,0,0,.2); color: rgba(255,255,255,.75); }
    .stack-card:nth-child(12) .stack-art { background: rgba(0,0,0,.12); color: rgba(0,0,0,.5); }
    .stack-card h3 {
      font-family: var(--font-display); font-size: 1.35rem;
      letter-spacing: .03em; margin: 0 0 .3rem;
    }
    .stack-card p { margin: 0; font-size: .92rem; line-height: 1.55; color: #3a4454; }
    .stack-card:nth-child(11) p { color: rgba(255,244,240,.8); }
    .stack-card:nth-child(12) p { color: rgba(0,0,0,.65); }
    .stack-card .quote { margin-top: .45rem; font-weight: 700; color: #22303f; }
    .stack-card:nth-child(11) .quote { color: #fff4f0; }
    .stack-card:nth-child(12) .quote { color: #111; }
    .stack-reset { display: none; text-align: center; margin-top: 1.2rem; }
    .stack-reset button {
      appearance: none; border: 1px solid rgba(212,232,71,.25);
      background: rgba(212,232,71,.07); color: var(--acid);
      border-radius: 999px; padding: .75rem 1.1rem;
      font-family: var(--font-body); font-size: .9rem; font-weight: 700; cursor: pointer;
    }
    .stack-reset button:hover { background: rgba(212,232,71,.14); color: var(--acid-2); }

    /* ── PREPARACIÓN ── */
    .why-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
    }
    .why-card {
      padding: 1.15rem; border-radius: var(--radius);
      background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.06);
    }
    .why-card h3 {
      font-family: var(--font-display); font-size: 1.4rem; letter-spacing: .03em;
      color: var(--acid); margin-bottom: .65rem;
    }
    .why-card p { color: var(--text-soft); font-size: .94rem; line-height: 1.6; }
    .method-split {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;
    }
    .mini-panel {
      border-radius: var(--radius-sm); padding: 1.1rem;
      background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.06);
    }
    .mini-panel h3 {
      font-family: var(--font-display); font-size: 1.25rem;
      letter-spacing: .04em; margin-bottom: .8rem;
    }
    .mini-panel ul { list-style: none; display: grid; gap: .5rem; }
    .mini-panel li {
      padding-left: 1rem; position: relative;
      color: var(--text-soft); font-size: .91rem; line-height: 1.5;
    }
    .mini-panel li::before { content: "–"; position: absolute; left: 0; color: rgba(255,255,255,.25); }

    /* ── AUTORIDAD ── */
    .authority-grid {
      display: grid; grid-template-columns: .8fr 1.2fr; gap: 1.25rem; align-items: start;
    }
    .authority-card {
      background: linear-gradient(180deg, rgba(17,24,32,.92), rgba(10,15,22,.97));
      border: 1px solid rgba(255,255,255,.06);
      border-radius: 28px; padding: 1.5rem;
      box-shadow: var(--shadow);
    }
    .timeline-box {
      background: rgba(255,255,255,.02); border: 1px solid rgba(255,255,255,.05);
      border-radius: 28px; padding: 1.5rem;
    }
    .timeline-list { list-style: none; display: grid; gap: 0; }
    .timeline-list li {
      padding: 1rem 0 1rem 1.1rem;
      border-left: 2px solid rgba(255,255,255,.08);
      position: relative;
    }
    .timeline-list li + li { }
    .timeline-list li::before {
      content: ""; position: absolute; left: -5px; top: 1.25rem;
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--acid); box-shadow: 0 0 0 3px rgba(212,232,71,.15);
    }
    .timeline-list .yr {
      font-family: var(--font-display); font-size: 1.45rem; color: var(--acid);
      letter-spacing: .04em; display: block; line-height: 1;
    }
    .timeline-list strong { display: block; margin: .2rem 0 .3rem; font-size: .98rem; }
    .timeline-list p { color: var(--text-soft); font-size: .88rem; line-height: 1.55; }
    .timeline-list a { font-weight: 700; }

    /* ── FAQ ── */
    .faq-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1.6rem; }
    .faq-item {
      padding: 1.1rem; border-radius: var(--radius);
      background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.06);
    }
    .faq-item h3 { font-family: var(--font-body); font-size: 1.02rem; font-weight: 600; margin-bottom: .5rem; }
    .faq-item p { color: var(--text-soft); font-size: .92rem; line-height: 1.6; }

    /* ── FUENTES (collapsible) ── */
    .sources-accordion { display: grid; gap: .75rem; }
    details.src-group {
      border-radius: var(--radius);
      background: rgba(255,255,255,.03);
      border: 1px solid rgba(255,255,255,.06);
      overflow: hidden;
    }
    details.src-group[open] {
      background: rgba(212,232,71,.03);
      border-color: rgba(212,232,71,.15);
    }
    details.src-group summary {
      list-style: none; cursor: pointer;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding: 1rem 1.1rem; font-weight: 700; font-size: .97rem;
    }
    details.src-group summary::-webkit-details-marker { display: none; }
    details.src-group summary::after {
      content: "+"; font-size: 1.2rem; color: var(--acid); flex-shrink: 0;
    }
    details.src-group[open] summary::after { content: "−"; }
    .src-list {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: .65rem;
      padding: 0 1.1rem 1.1rem;
    }
    .src-list a {
      display: block; padding: .8rem .9rem; border-radius: var(--radius-sm);
      background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.05);
      color: var(--text-soft); font-weight: 600; font-size: .88rem; line-height: 1.4;
    }
    .src-list a:hover { color: var(--text); border-color: rgba(212,232,71,.25); background: rgba(212,232,71,.06); }

    /* ── CTA / CONTACTO ── */
    .cta-panel {
      background: linear-gradient(180deg, rgba(17,24,32,.97), rgba(8,12,18,.99));
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 28px; padding: 1.8rem;
      box-shadow: var(--shadow); margin-top: 2rem;
    }
    .cta-panel h3 {
      font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem);
      letter-spacing: .04em; text-transform: uppercase; color: var(--acid);
      margin-bottom: .5rem;
    }
    .cta-panel > p { margin-bottom: 1rem; color: var(--text-mid); max-width: 680px; line-height: 1.65; }
    .cta-note {
      font-family: var(--font-mono); font-size: .72rem;
      text-transform: uppercase; letter-spacing: .1em;
      color: var(--text-soft); margin-top: .9rem;
    }

    /* ── FOOTER ── */
    footer {
      padding: 1.8rem 0 2.5rem;
      border-top: 1px solid rgba(255,255,255,.05);
      background: rgba(0,0,0,.12);
    }
    .footer-inner {
      width: min(var(--container), calc(100% - 2rem));
      margin: 0 auto; display: grid; gap: 1.1rem;
    }
    .footer-top {
      display: flex; flex-wrap: wrap; align-items: center;
      justify-content: space-between; gap: 1rem;
    }
    .footer-links {
      display: flex; flex-wrap: wrap; gap: .55rem;
    }
    .footer-links a {
      font-family: var(--font-mono); font-size: .72rem;
      text-transform: uppercase; letter-spacing: .08em;
      color: var(--text-soft); padding: .35rem .6rem;
      border-radius: 8px; border: 1px solid rgba(255,255,255,.06);
    }
    .footer-links a:hover { color: var(--text); }
    .footer-sources { display: flex; flex-wrap: wrap; gap: .5rem; }
    footer small {
      color: var(--text-soft); font-family: var(--font-mono);
      font-size: .72rem; letter-spacing: .04em; line-height: 1.8;
    }

    /* ── RESPONSIVE ── */
    @media (min-width: 1440px) {
      :root { --container: 1280px; }
    }

    @media (max-width: 1080px) {
      .hero-grid, .authority-grid { grid-template-columns: 1fr; }
      .evidence-band { grid-template-columns: repeat(2, 1fr); }
      .why-grid { grid-template-columns: repeat(2, 1fr); }
      .src-list { grid-template-columns: 1fr; }
    }

    @media (max-width: 768px) {
      :root { --navh: 62px; }
      .nav-links { display: none; flex-direction: column; gap: .4rem; }
      .nav-links.open {
        display: flex; position: absolute; top: var(--navh); left: 0; right: 0;
        background: rgba(4,6,8,.97); border-bottom: 1px solid rgba(255,255,255,.06);
        padding: .85rem 1rem 1.2rem; z-index: 999;
      }
      .nav-links.open li { width: 100%; }
      .nav-links.open a {
        display: block; padding: .65rem .8rem;
        border-radius: var(--radius-sm); width: 100%;
      }
      .nav-toggle { display: flex; }
      .split-grid, .method-split, .faq-grid { grid-template-columns: 1fr; }
      .why-grid { grid-template-columns: 1fr; }
      .stack-wrap { height: 580px; }
      .section-title { font-size: 2.1rem; }
    }

    @media (max-width: 540px) {
      h1 { font-size: 3.1rem; }
      .section { padding: 3.5rem 0; }
      .evidence-band { grid-template-columns: 1fr; }
      .hero-main, .hero-aside, .cta-panel { padding: 1.1rem; }
      .authority-grid > * { border-radius: var(--radius); }
      .stack-wrap { height: 520px; width: 100%; }
      .stack-card h3 { font-size: 1.2rem; }
      .footer-sources { gap: .4rem; }
    }
  </style>
</head>
